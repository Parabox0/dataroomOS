# Dataroom OS settings. Copy this file to .env.local and fill in what you need.
# Every line is optional. With none of them, the app runs on your computer with a built-in database.

# Your product name, shown in the app, page titles and viewer pages. Default: Dataroom OS.
NEXT_PUBLIC_APP_NAME=

# The address people open the app at, like https://rooms.example.com. Sent to OpenRouter as the referring site.
DATAROOM_PUBLIC_URL=

# A Postgres database, for example Supabase (Connect, then "Session pooler").
# Leave empty to use the built-in database saved in ./.data/pglite.
DATABASE_URL=

# Set to 1 if you applied supabase/migrations yourself and the app should not create tables on start.
DATAROOM_SKIP_MIGRATE=

# Set to 0 to start with no sample room (Brightloaf) and hide the sample button. Do this before real people use it.
DATAROOM_DEMO_DATA=

# Where the built-in database and uploaded files live. On Railway, point both at a mounted volume, like /data/pglite and /data/files.
PGLITE_DIR=
FILES_DIR=

# A long random string that signs sign-in and viewer cookies. Make one with: openssl rand -hex 32
# If empty, the app makes one and saves it in ./.data/secret.
DATAROOM_SECRET=

# Where the app keeps the secret it makes itself. On Railway, put it on the volume, like /data/secret.
DATAROOM_SECRET_FILE=

# Optional. With a key, Ask, file summaries, reply drafts and Check the room use Claude.
# OpenRouter (used first when set). Get a key at openrouter.ai.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-fable-5.2
# Or Claude directly from Anthropic.
# Without it, the app uses its built-in search and still shows sources.
ANTHROPIC_API_KEY=
DATAROOM_MODEL=claude-opus-5-5

# Only for testing on plain http (not https) away from localhost. Leave empty when hosted.
DATAROOM_INSECURE_COOKIE=

# Sign-in through Clerk (optional). Both keys are needed; with either one missing, the built-in email and password sign-in is used.
# The publishable key is public. The secret key is private: paste it in yourself, never into chat.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
