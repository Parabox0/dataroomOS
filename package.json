{
  "name": "dataroom-os",
  "version": "0.1.0",
  "private": true,
  "description": "Buildbase: a data room that tells you what is missing, answers with sources, and explains who is serious.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -rf .data && echo 'Local data cleared. Demo data comes back on the next start.'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@clerk/nextjs": "7.9.25",
    "@electric-sql/pglite": "0.5.16",
    "@napi-rs/canvas": "^0.1.80",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "postgres": "^3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
